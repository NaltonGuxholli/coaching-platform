DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/coaching_platform"
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="15m"
PORT=3000

# Optional POK payment provider configuration
POK_API_URL="https://api.pok.example"
POK_API_KEY="your-pok-api-key-here"
POK_WEBHOOK_SECRET="your-pok-webhook-secret-here"

# DRM provider selection
DRM_PROVIDER="simple"

# Optional email queue processor interval (milliseconds)
EMAIL_PROCESS_INTERVAL_MS=30000

# Optional backend behavior
NODE_ENV=development
